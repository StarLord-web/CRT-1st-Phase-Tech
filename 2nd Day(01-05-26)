//  PROBLEM 05: FOR LOOP 
//  Task: print 1 to n and skip any num divisible by 4

#include<iostream>
using namespace std;

int main(){
int n;
cout<<"Enter number: ";
cin>>n;

for(int i=1; i<=n; i++){
    if(i%4==0){
        continue;
    } else{
        cout<<i<<" ";
    }
}
return 0;
}