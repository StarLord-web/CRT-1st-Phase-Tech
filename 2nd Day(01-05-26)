//  PROBLEM 01: THE IF CONDITION 
//  Task: Verify if a user is eligible to vote

#include <iostream>
using namespace std;

int main() {
    int age;
    cin >> age;
    // if condition 
    if(age >= 18) { 
        cout << "Eligible For vote";
    } 
    return 0;
}

//  PROBLEM 02: THE IF-ELSE BRANCH 
//  Task: Handle both eligible and ineligible cases

#include <iostream>
using namespace std;

int main() {
    int age;
    cin >> age;
    // if condition 
    if(18<=age<=79) {
        cout << "Eligible For vote - Working Citizen";
    }
    //else if condition 
    else if(80<=age<=100){
        cout<< "Eligible to vote - Senior Citizen";
    }
    else if(age>100){
        cout<< "Eligible to vote - Old aged";
    }
    //else  condition
    else if(0<age<=17){
        cout << "Not Eligible For vote";
    }
    else{
        cout<<"Invalid input";
    }
    return 0;
}

//  PROBLEM 03: NESTED IF-ELSE LOGIC 
//  Task: Advanced validation for seniors and invalid ages

#include <iostream>
using namespace std;

int main() {
    int age;
    cin >> age;
    
    if(age >= 18) {
        if (age >= 100) {
            cout <<"Eligible for Vote (But we are Super senior citizen";
        } else {
            cout <<"Eligible for Vote";
        }
    } else {
        if(age < 0) {
            cout << "Enter a Valid Age number";
        } else {
            cout << "Not Eligible for Vote";
        }
    }
    return 0;
}

